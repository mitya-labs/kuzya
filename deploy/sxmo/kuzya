#!/bin/sh
# title="Кузя"
# Пункт меню SXMO «Scripts»: открывает терминал с Кузей (команда kuzya сама поднимает и останавливает сервер).
# Запуск из сессии SXMO нужен, чтобы nmcli (wifi_connect) имел право управлять NetworkManager (polkit: локальная активная сессия).
# Ставится в ~/.config/sxmo/userscripts/kuzya; запускатель — ~/.local/bin/kuzya.
exec sxmo_terminal.sh "$HOME/.local/bin/kuzya"
